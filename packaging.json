{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "just-every/handset",
    "name": "Handset",
    "sourceRepository": "https://github.com/just-every/run-handset",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "rer-worker-artifact.json"
    },
    "operations": {
      "setup": "pnpm install --frozen-lockfile",
      "build": "pnpm run build",
      "verify": "pnpm run verify && pnpm check:deployment-spec",
      "artifact": "node scripts/delivery/base/cli.mjs artifact --config packaging.json",
      "recovery": "Follow docs/backup.md and RUN-LOCALLY.md. Retain exact source, private settings and a database export before changes. Restore into fresh empty resources, preserve applied migration names and bytes, establish the owner, re-export and compare supported records before routing traffic."
    },
    "verification": {
      "migrationDirectories": [
        "migrations/core"
      ]
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@34cf6c23b5cb86eff0068049bc39feeb38c8ffa9",
    "artifactFile": "rer-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ]
  },
  "artifact": {
    "specInputs": {
      "publicVariableNames": [
        "AUTH_ORIGIN",
        "AUTH_LOCAL",
        "IDENTITY_PROVIDER",
        "MAIL_PROVIDER",
        "MAIL_FROM",
        "MAIL_RELAY_URL",
        "MAIL_ACCOUNT_ID",
        "HANDSET_DIAL_ORIGIN",
        "HANDSET_ORBIT_ORIGIN",
        "HANDSET_HELPDESK_ORIGIN",
        "OWNER_EMAIL"
      ],
      "secretNames": [
        "SESSION_SECRET",
        "INSTALLATION_KEY",
        "SETUP_TOKEN",
        "MAIL_API_KEY"
      ],
      "optionalSecretNames": [
        "INSTALLATION_KEY_PREVIOUS",
        "HANDSET_TWILIO_AUTH_TOKEN",
        "HANDSET_DIAL_TOKEN",
        "HANDSET_STRIPE_KEY",
        "HANDSET_ORBIT_TOKEN",
        "HANDSET_HELPDESK_TOKEN"
      ],
      "migrationPrefix": "core-",
      "healthPath": "/health",
      "recovery": "Follow docs/backup.md and RUN-LOCALLY.md. Retain the database export and exact source before migration. Restore into empty resources, set up the owner and verify records before switching traffic.",
      "providerEffects": [
        "outbound-mail",
        "outbound-webhooks",
        "telephony",
        "payments"
      ],
      "surfaces": {
        "app": {
          "path": "/signin",
          "originVariable": "AUTH_ORIGIN",
          "signIn": {
            "path": "/signin",
            "loginHint": true,
            "ownerSignIn": "/auth/owner-signin"
          }
        }
      },
      "mail": {
        "providers": [
          "rer",
          "resend",
          "sendgrid",
          "cloudflare"
        ]
      }
    }
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  }
}
