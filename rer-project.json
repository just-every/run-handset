  "license": "MIT",
  "deployment": {
    "target": "cloudflare-workers",
    "artifactFile": "rer-worker-artifact.json"
  },
  "operations": {
    "setup": "pnpm install --frozen-lockfile",
    "build": "pnpm run build",
    "verify": "pnpm run verify && pnpm check:deployment-spec",
    "artifact": "node scripts/delivery/base/cli.mjs artifact --config packaging.json",
    "recovery": "Follow docs/backup.md and RUN-LOCALLY.md. Retain exact source, private settings and a database export before changes. Restore into fresh empty resources, preserve applied migration names and bytes, establish the owner, re-export and compare supported records before routing traffic."
  },
  "verification": {
    "migrationDirectories": [
      "migrations/core"
    ]
  },
  "setup": {
    "path": "rer-setup.json",
    "sha256": "6d5f53b24ddb543d934edd066ad54d9848437040d4cb48d3610a081cbe253e71"
  }
}
